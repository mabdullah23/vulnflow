PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@vulnflow-cluster.qkec2un.mongodb.net/vulnflow
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
API_URL=http://localhost:5000
# Same Firebase project ID as VITE_FIREBASE_PROJECT_ID in FE/.env.
FIREBASE_PROJECT_ID=
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b
